# Port du serveur backend (API + fichiers statiques en prod)
PORT=42069

# --- Base de données PostgreSQL (service `db` du docker-compose) ---
# Identifiants du conteneur Postgres. Le compose s'en sert à la fois pour
# initialiser la bdd et pour assembler la DATABASE_URL de l'application.
POSTGRES_USER=bonvoyage
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=bonvoyage

# Publication du port sur l'hôte, pour se connecter depuis l'extérieur
# (DBeaver, pgAdmin, psql).
# ⚠️ Docker publie ses ports en écrivant directement dans iptables et
# court-circuite ufw/firewalld : 0.0.0.0 sur une machine exposée rend Postgres
# joignable depuis Internet quel que soit le pare-feu.
#   127.0.0.1 = hôte uniquement (recommandé, via tunnel SSH ou Tailscale)
#   0.0.0.0   = ouvert à tout le réseau — mot de passe fort obligatoire
DB_BIND_HOST=127.0.0.1
DB_PORT=5432

# Chaîne de connexion utilisée par l'application.
# En Docker : recalculée par le compose depuis les POSTGRES_* ci-dessus
#             (l'hôte y est `db`, le nom du service).
# En dev local (`npm run dev`) : c'est celle-ci qui sert, host = localhost.
DATABASE_URL=postgres://bonvoyage:change-moi@localhost:5432/bonvoyage

# --- Envoi d'emails (invitations) — OPTIONNEL ---
# Sans configuration : mode "console" (l'email est loggé, le lien d'invitation
# reste copiable dans l'UI). Idéal pour du self-hosted sans serveur mail.
#
# Pour envoyer réellement (recommandé en SaaS) : Resend (https://resend.com,
# 3000 emails/mois gratuits). Renseignez la clé API et l'expéditeur.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Bon Voyage <invitations@votre-domaine.com>

# URL publique de l'app, pour construire les liens des emails (ex. lien d'invitation).
# En dev, laissez vide : l'origine de la requête est utilisée (http://localhost:5173).
# APP_URL=https://voyage.votre-domaine.com
